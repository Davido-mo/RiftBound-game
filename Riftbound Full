.board-wrap{background:#0c1829}.board-wrap:before{display:none}#backdrop{z-index:0;image-rendering:pixelated;opacity:.92;filter:saturate(1.08)}#board{z-index:1}.board-note{z-index:2}.buffer-panel{display:flex;align-items:center;flex-wrap:wrap;gap:8px 14px;padding:9px 12px;border-radius:12px;border:1px solid #416982;background:linear-gradient(100deg,#122c41de,#0f2038d9);min-height:47px}.buffer-panel>div:first-child{display:flex;gap:10px;align-items:center;font-size:13px;color:#d8f3f5}.buffer-panel span{color:#98bacb;font-size:12px}.buffer-list{display:flex;gap:4px;align-items:center;flex-wrap:wrap;min-width:20px}.buffer-pill{min-width:24px;text-align:center;padding:3px 5px;border:1px solid #77cbd3;border-radius:5px;background:#236479;color:#e8fbf2;font-size:12px;font-weight:800}.buffer-panel small{font-size:11px;color:#92b7c6}.title-screen .logo{filter:drop-shadow(0 16px 25px #3bc6ca53)}.title-screen h1{background:linear-gradient(170deg,#f4ffff 10%,#92f0e0 50%,#52adc7 85%);background-clip:text;color:transparent;text-shadow:none}.world-2 .world-heading{color:#ffc7a0}.world-1 .world-heading{color:#b8f2df}@media(max-width:720px){.buffer-panel small{width:100%}.buffer-panel{gap:5px 10px}}

