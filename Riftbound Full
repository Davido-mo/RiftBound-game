.shop-screen{gap:20px;background:radial-gradient(circle at 73% 27%,#30536a57,transparent 38%),radial-gradient(circle at 16% 57%,#52396255,transparent 43%)}.shop-topbar{align-items:flex-start}.shop-topbar .shop-head-actions{display:flex;align-items:center;gap:13px;flex-wrap:wrap}.shop-wallet{display:flex;align-items:center;gap:9px;padding:10px 15px;border:1px solid #cda970;border-radius:13px;background:linear-gradient(130deg,#443629,#252e41);color:#ffe4a2;font-weight:850;box-shadow:0 0 25px #f5ba5640}.shop-wallet strong{font-size:26px;line-height:1}.shop-wallet .wallet-star{font-size:29px;filter:drop-shadow(0 0 8px #ffd7799a)}.shop-intro{margin-top:2px;border:1px solid #558895;border-radius:20px;background:linear-gradient(120deg,#173849,#192b43 64%,#2b2b42);box-shadow:inset 0 1px #ffffff25,0 14px 35px #050b1940;display:grid;grid-template-columns:minmax(230px,1fr) minmax(180px,240px);gap:18px;padding:20px 23px;align-items:center}.shopkeeper{display:flex;align-items:center;gap:16px}.pip-character{position:relative;width:96px;height:118px;flex:0 0 96px;border:0;background:none;padding:0;filter:drop-shadow(0 9px 12px #03081690);animation:pipFloat 3.2s ease-in-out infinite}.pip-character:hover{transform:scale(1.05)}.pip-halo{position:absolute;inset:7px 10px 15px;border:11px solid #8fefdf;border-radius:49% 51% 48% 52%;background:radial-gradient(circle at 70% 28%,#7281ba,#25294a 65%);box-shadow:inset 0 0 15px #70d6f8,0 0 23px #83e6d580}.pip-halo:before{content:"";position:absolute;top:-20px;left:20px;border-left:14px solid transparent;border-right:14px solid transparent;border-bottom:20px solid #aaf8e2;transform:rotate(-16deg)}.pip-eye{position:absolute;top:49px;width:12px;height:15px;border-radius:50%;background:#f9e6a6;box-shadow:0 0 7px #ffe196}.pip-eye.left{left:33px}.pip-eye.right{right:33px}.pip-mouth{position:absolute;top:75px;left:43px;width:15px;height:9px;border:3px solid #f6d8aa;border-top:0;border-radius:0 0 12px 12px}.pip-foot{position:absolute;bottom:4px;width:15px;height:20px;border-radius:5px 5px 9px 9px;background:#9ddfd3}.pip-foot.left{left:28px;transform:rotate(17deg)}.pip-foot.right{right:28px;transform:rotate(-17deg)}@keyframes pipFloat{0%,100%{translate:0 0}50%{translate:0 -7px}}.pip-copy{min-width:0}.pip-name{font-weight:900;font-size:18px;color:#a9f4e0}.pip-role{font-size:11px;color:#acc1d0;letter-spacing:.12em;text-transform:uppercase}.pip-line{line-height:1.45;color:#e9f8f3;margin:8px 0 11px;min-height:43px}.talk-button{padding:8px 12px;font-size:12px;border-radius:9px}.shop-preview{display:flex;align-items:center;gap:10px;border-left:1px solid #58758a;padding-left:18px;min-height:125px}.shop-preview-label{font-size:10px;letter-spacing:.13em;color:#b4c8d1;text-transform:uppercase;font-weight:800}.shop-preview-name{font-size:15px;font-weight:800;margin-top:3px}.skin-cube{--skin-low:#0d3d4d;--skin-high:#51bbac;--skin-accent:#d6e9ad;position:relative;width:72px;height:104px;margin:12px 17px 6px 9px;flex:0 0 72px;background:linear-gradient(145deg,#ffffff72,transparent 31%),linear-gradient(0deg,var(--skin-low),var(--skin-high) 72%,var(--skin-accent));border:1px solid #ffffff94;transform:skewY(-11deg);border-radius:3px;box-shadow:inset 7px 0 12px #ffffff1e,inset -9px -4px 16px #0006,0 10px 18px #0008}.skin-cube:before{content:"";position:absolute;bottom:7px;left:100%;width:20px;height:100%;background:linear-gradient(95deg,var(--skin-low),#0c1b27);transform-origin:left bottom;transform:skewY(29deg);border:1px solid #ffffff57}.skin-cube:after{content:"";position:absolute;bottom:100%;left:0;width:100%;height:20px;background:linear-gradient(115deg,var(--skin-accent),var(--skin-high));transform-origin:left bottom;transform:skewX(-60deg);border:1px solid #ffffff8a}.shop-explainer{margin:0;color:#b7ccda;line-height:1.45;font-size:13px}.shop-explainer strong{color:#ffe5a4}.shop-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding-bottom:8px}.skin-card{position:relative;display:flex;flex-directio