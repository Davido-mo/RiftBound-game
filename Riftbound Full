/* Two shopkeepers and a one-star dice wager */
.shop-intro{grid-template-columns:minmax(0,1fr) minmax(190px,225px);align-items:stretch;padding:16px;gap:15px}.shop-npcs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:stretch}.shopkeeper{border:1px solid #4c7481;border-radius:14px;background:#0d2538a8;padding:11px;gap:7px;align-items:flex-start}.pip-character{width:68px;height:86px;flex-basis:68px;scale:.73;transform-origin:top left;margin-right:-18px;margin-bottom:-17px}.pip-name,.dax-name{font-size:15px;line-height:1.2}.pip-line{font-size:12px;min-height:62px;margin:8px 0}.npc-actions{display:flex;gap:5px;flex-wrap:wrap}.npc-actions .button{padding:7px 9px}.dax-card{border-color:#ac805b;background:linear-gradient(145deg,#342c37ad,#172a3aad)}.dax-name{font-weight:900;color:#ffd89c}.dax-character{position:relative;width:66px;height:75px;flex:0 0 66px;background:none;border:0;filter:drop-shadow(0 10px 8px #0008);animation:daxFloat 2.8s ease-in-out infinite}.dax-face{position:absolute;inset:9px 5px 4px;clip-path:polygon(50% 0,92% 18%,100% 68%,52% 100%,5% 68%,10% 16%);background:linear-gradient(135deg,#fff3bf 2%,#e3a257 43%,#9b4f52 90%);border:2px solid #fff0bd;box-shadow:inset -11px -9px 13px #542d4a8c}.dax-face i{position:absolute;width:6px;height:7px;border-radius:50%;background:#482c3f;box-shadow:0 0 3px #422a36}.dax-face i:nth-child(1){left:15px;top:22px}.dax-face i:nth-child(2){right:14px;top:22px}.dax-face i:nth-child(3){left:15px;bottom:16px}.dax-face i:nth-child(4){right:14px;bottom:16px}.dax-face i:nth-child(5){left:25px;top:31px;width:8px;height:8px;background:#fceac2}.dax-brow{position:absolute;top:24px;left:20px;width:27px;height:8px;border-top:3px solid #532d38;transform:rotate(-9deg)}.dax-character.rolling .dax-face{animation:dieToss .6s ease-out}.dax-character:hover{filter:drop-shadow(0 0 12px #ffbe6ba9)}@keyframes daxFloat{0%,100%{translate:0 0}50%{translate:0 -5px}}@keyframes dieToss{0%{transform:rotate(0) scale(1)}48%{transform:rotate(170deg) scale(.75)}100%{transfor