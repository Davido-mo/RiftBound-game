*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,Segoe UI,sans-serif;background:radial-gradient(circle at 72% 12%,#255671 0,#152c48 22%,#0c1729 54%,#080e1b 100%);color:var(--text)}button{font:inherit;cursor:pointer}button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
#app{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}.shell{width:min(1060px,100%);min-height:min(740px,calc(100vh - 40px));border:1px solid #39516c;border-radius:28px;background:linear-gradient(150deg,#15243cdd,#0d182bdc);box-shadow:0 30px 90px #0008, 0 0 70px #3fc2d012, inset 0 1px #ffffff16;overflow:hidden;position:relative}.shell:before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 75% 20%,#59cfbd19,transparent 42%)}.screen{position:relative;z-index:1;min-height:700px;padding:30px 38px;display:flex;flex-direction:column}.hidden{display:none!important}
.brand{font-size:12px;letter-spacing:.27em;text-transform:uppercase;color:var(--cyan);font-weight:800}.title-screen{align-items:center;justify-content:center;text-align:center;gap:22px}.logo{width:146px;height:126px;position:relative;filter:drop-shadow(0 18px 20px #0008);margin-bottom:5px}.logo .diamond{position:absolute;left:23px;top:14px;width:100px;height:100px;background:linear-gradient(135deg,#aafdf0,#4cc6ce);transform:rotate(45deg);border:7px solid #d5fff4;border-radius:16px;box-shadow:inset -20px -20px #278ba5}.logo .cut{position:absolute;left:48px;top:40px;width:50px;height:50px;background:#14263e;transform:rotate(45deg);border:5px solid #437e93;border-radius:8px}.title-screen h1{font-size:clamp(55px,10vw,110px);line-height:.95;letter-spacing:-.075em;margin:0;text-shadow:0 8px 30px #0006}.byline{font-size:18px;color:var(--gold);letter-spacing:.08em;margin:0}.lede{max-width:490px;color:var(--muted);line-height:1.6;margin:0}.button{border:1px solid #96f7e5;border-radius:14px;background:linear-gradient(135deg,#79efe1,#3cb6c8);color:#082137;padding:14px 26px;font-weight:850;box-shadow:0 9px 24px #41d6c033;transition:transform .15s,filter .15s}.button:hover{transform:translateY(-2px);filter:brightness(1.1)}.button.secondary{background:#1c3048;color:var(--text);border-color:#476583;box-shadow:none}.button.ghost{background:transparent;color:var(--muted);border-color:#354f6d;box-shadow:none}.button:disabled{opacity:.45;cursor:not-allowed;transform:none}.title-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}.hint{color:#7895aa;font-size:13px}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px}.topbar h2{font-size:clamp(30px,5vw,48px);margin:8px 0 3px;letter-spacing:-.05em}.sub{color:var(--muted);margin:0}.level-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin:36px 0 26px}.level-card{min-height:142px;text-align:left;background:linear-gradient(145deg,#1a304a,#12233b);border:1px solid #3b5873;border-radius:18px;padding:17px;display:flex;flex-direction:column;justify-content:space-between;color:var(--text);transition:transform .15s,border-color .15s}.level-card:hover:not(:disabled){transform:translateY(-3px);border-color:var(--cyan)}.level-card:disabled{cursor:not-allowed;opacity:.48;filter:saturate(.65)}.level-card .num{font-size:32px;font-weight:900;color:var(--cyan);letter-spacing:-.06em}.level-card .name{font-weight:750}.level-card .state{font-size:12px;color:var(--muted)}.level-card.done .state{color:var(--gold)}.level-card.locked .num{color:#91a4b6}.legend{margin-top:auto;color:var(--muted);line-height:1.6}
